# Elasticsearch secrets for the FABRIC ES slice — TEMPLATE (safe to commit).
#
# Copy to deploy/elastic-stack/.env (gitignored), then chmod 600 it and fill in
# real values:
#     cp deploy/elastic-stack/.env.template deploy/elastic-stack/.env
#     chmod 600 deploy/elastic-stack/.env
#     $EDITOR deploy/elastic-stack/.env
#
# Source it for recipe runs / curl provisioning with:
#     set -a; . deploy/elastic-stack/.env; set +a
#
# Generate strong values, e.g.:  openssl rand -hex 32
#
# ELASTIC_PASSWORD        = elastic superuser (one-time provisioning + debugging).
# ELASTIC_INGEST_PASSWORD = scoped vector_ingest user. This value MUST MATCH the
#                           ELASTIC_INGEST_PASSWORD set on the Vector side
#                           (deploy/vector/.env), or ingestion auth will fail.
#
# Do NOT set KIBANA_SERVICE_TOKEN or KIBANA_ENCRYPTION_KEY by hand.
# deploy/fabric/bootstrap_es_node.sh AUTO-APPENDS both to this .env once ES is
# healthy (it mints a kibana_system service-account token and a saved-objects
# encryption key). Anything you put there by hand will be duplicated/ignored.
ELASTIC_PASSWORD=<generate-a-strong-password>
ELASTIC_INGEST_PASSWORD=<generate-a-strong-password>
