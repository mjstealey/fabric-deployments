# Vector ingest secret — TEMPLATE (safe to commit).
#
# Copy to deploy/vector/.env (gitignored), then chmod 600 it and fill in the
# real value:
#     cp deploy/vector/.env.template deploy/vector/.env
#     chmod 600 deploy/vector/.env
#     $EDITOR deploy/vector/.env
#
# Source it before launching Vector with:
#     set -a; . deploy/vector/.env; set +a
#
# ELASTIC_INGEST_PASSWORD is the password for the scoped vector_ingest user.
# It MUST EQUAL ELASTIC_INGEST_PASSWORD in deploy/elastic-stack/.env — that is
# the same user/password on both sides of the wire. If they differ, Vector's
# basic-auth to Elasticsearch will be rejected.
ELASTIC_INGEST_PASSWORD=<generate-a-strong-password>
